<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Rivio_RegressionSuite_Full" verbose="2" parallel="none" thread-count="1">

    <listeners>
        <listener class-name="com.cts.rivio.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <!-- Group-based filter: run every @Test annotated with groups = {"regression"}.
         Every test in the codebase carries the "regression" group, so this is
         equivalent to "run everything" — but the selection is now driven by the
         Java annotation instead of by class enumeration here. -->
    <groups>
        <run>
            <include name="regression"/>
        </run>
    </groups>

    <!-- ═══ ADMIN BUCKET (Super Admin role) ═══ -->
    <test name="Admin_Bucket">
        <classes>
            <class name="com.cts.rivio.tests.DashboardTest"/>
            <class name="com.cts.rivio.tests.EmployeeTest"/>
            <class name="com.cts.rivio.tests.AttendanceTest"/>
            <class name="com.cts.rivio.tests.LeaveTest"/>
            <class name="com.cts.rivio.tests.PayrollTest"/>
            <class name="com.cts.rivio.tests.RecruitmentTest"/>
            <class name="com.cts.rivio.tests.RecruitmentFormTest"/>
            <class name="com.cts.rivio.tests.CompanyStructureTest"/>
            <class name="com.cts.rivio.tests.ReportsAnalyticsTest"/>
        </classes>
    </test>

    <!-- ═══ HR BUCKET ═══ -->
    <test name="HR_Bucket">
        <classes>
            <class name="com.cts.rivio.tests.HrWorkflowTest"/>
        </classes>
    </test>

    <!-- ═══ MANAGER BUCKET ═══ -->
    <test name="Manager_Bucket">
        <classes>
            <class name="com.cts.rivio.tests.ManagerWorkflowTest"/>
        </classes>
    </test>

    <!-- ═══ PAYROLL MANAGER BUCKET ═══ -->
    <test name="PayrollManager_Bucket">
        <classes>
            <class name="com.cts.rivio.tests.PayrollManagerWorkflowTest"/>
            <class name="com.cts.rivio.tests.PayrollFormTest"/>
        </classes>
    </test>

    <!-- ═══ EMPLOYEE BUCKET (Self-service + role-guard denials) ═══ -->
    <test name="Employee_Bucket">
        <classes>
            <class name="com.cts.rivio.tests.MyProfileTest"/>
            <class name="com.cts.rivio.tests.MyAttendanceTest"/>
            <class name="com.cts.rivio.tests.MyLeavesTest"/>
            <class name="com.cts.rivio.tests.LeaveApplyTest"/>
            <class name="com.cts.rivio.tests.MyPayslipsTest"/>
            <class name="com.cts.rivio.tests.EmployeeAccessTest"/>
        </classes>
    </test>

    <!-- ═══ MIXED / AUTH BUCKET (classes that test auth flow itself) ═══ -->
    <test name="Mixed_Auth_And_RoleMatrix">
        <classes>
            <class name="com.cts.rivio.tests.LoginTest"/>
            <class name="com.cts.rivio.tests.RoleAccessTest"/>
            <class name="com.cts.rivio.tests.AIPolicyAssistantTest"/>
            <class name="com.cts.rivio.tests.SecurityAuditTest"/>
            <class name="com.cts.rivio.tests.RoleMatrixTest"/>
            <class name="com.cts.rivio.tests.LogoutTest"/>
        </classes>
    </test>

</suite>
